        "action": {
          "click": {
            "at": {
              "coordinate": {
                "_0": [
                  -9,
                  18
                ]
              }
            },
            "clickCount": 1,
            "mouseButton": 0
          }
        },
        "app": "fixture"
      }
    }
  },
